<local:FlyoutUserControlBase
    x:Class="CorlaneCabinetOrderFormV3.Views.UpperCabinetFlyouts.UpperRemovePartsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CorlaneCabinetOrderFormV3.Views.BaseCabinetFlyouts">
    <local:FlyoutUserControlBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource FlyoutTextBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource FlyoutCheckBox}"/>
        <Style TargetType="Label" BasedOn="{StaticResource FlyoutLabel}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FlyoutComboBox}"/>
    </local:FlyoutUserControlBase.Resources>
    <StackPanel>
        <TextBlock Text="Remove Cabinet Parts" 
                   FontSize="16" FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <CheckBox Content="Has Top" 
                  IsChecked="{Binding HasTop}" 
                  Margin="0,5"/>

        <CheckBox Content="Has Deck" 
                  IsChecked="{Binding HasDeck}" 
                  Margin="0,5"/>

        <CheckBox Content="Has Left End" 
                  IsChecked="{Binding HasLeftEnd}" 
                  Margin="0,5"/>

        <CheckBox Content="Has Right End" 
                  IsChecked="{Binding HasRightEnd}" 
                  Margin="0,5"/>

        <CheckBox Content="Has Back" 
                  IsChecked="{Binding HasBack}" 
                  Margin="0,5"/>
    </StackPanel>
</local:FlyoutUserControlBase>